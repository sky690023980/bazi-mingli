# Production Environment Variables (Railway)
# These override .env values on deployment

# LLM Provider: ollama | openai | qwen
llm_provider = ollama

# Ollama base URL (update after deployment)
ollama_base_url = http://localhost:11434
ollama_model = qwen2.5:14b
llm_temperature = 0.3
llm_max_tokens = 800

# Server
host = 0.0.0.0
port = 8001
debug = false
